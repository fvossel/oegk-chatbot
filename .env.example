# Copy this file to `.env` and fill in your credentials.
# `.env` is gitignored and must never be committed.

# --- Required credentials ------------------------------------------------
OPENAI_API_KEY="sk-..."
OEP_TOKEN="your-oep-api-token"

# --- Optional overrides (defaults shown) ---------------------------------
# Models
# OEKG_SPARQL_MODEL=gpt-5.4-mini
# OEKG_SUMMARY_MODEL=gpt-5.4-nano
# OEKG_EMBEDDING_MODEL=text-embedding-3-large

# Retrieval / pipeline limits
# OEKG_RETRIEVAL_TOP_K=10
# OEKG_MAX_USER_HISTORY=5
# OEKG_MAX_SUMMARY_CHARS=10000
# OEKG_MAX_INPUT_CHARS=2000
# OEKG_URI_VALIDATION=1

# OEP SPARQL endpoint
# OEKG_SPARQL_ENDPOINT=https://openenergyplatform.org/api/v0/oekg/sparql/
# OEKG_SPARQL_RETRIES=3
# OEKG_SPARQL_RETRY_DELAY=2
# OEKG_SPARQL_TIMEOUT=30
# OEKG_SPARQL_REPAIR_ROUNDS=2

# Caching
# OEKG_CACHE_ENABLED=1
# OEKG_CACHE_PATH=query_cache.json

# Logging
# OEKG_LOG_DIR=logs
# OEKG_LOG_LEVEL=INFO

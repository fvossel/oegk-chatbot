# Copy this file to `.env` and fill in your credentials.
# `.env` is gitignored and must never be committed.

# --- Required credentials ------------------------------------------------
# Chat and embeddings are two separate university services, so they need two
# keys. Neither falls back to the other: that would hand one service a
# credential for another. See OEKG_LLM_BASE_URL / OEKG_EMBEDDING_BASE_URL.
LLM_API_KEY="your-kiwi-api-key"
EMBEDDING_API_KEY="your-gateway-api-key"
OEP_TOKEN="your-oep-api-token"

# --- Optional overrides (defaults shown) ---------------------------------
# Chat: KiWi, a LibreChat agents API, so the "model" is an agent id. Reasoning
# belongs to the agent, not the request, hence two agents: the reasoning one
# for SPARQL (slow, over two minutes) and the plain one for summaries.
# OEKG_LLM_BASE_URL=https://kiwi-secure.uni-osnabrueck.de/api/agents/v1
# OEKG_SPARQL_MODEL=agent_NpAmRwLMlX5QBrUiqcwjM
# OEKG_SUMMARY_MODEL=agent_7qE8YPFNPQ9KQQInK9FNc
# Also request no reasoning for the short tasks. KiWi ignores it; endpoints
# that honour it need only one model. Set to 0 where unknown parameters are
# rejected outright.
# OEKG_LLM_NO_THINK=1
# Generous on purpose: the reasoning agent needs minutes for one query.
# OEKG_LLM_TIMEOUT=300
# OEKG_LLM_MAX_RETRIES=1

# Embedding model. Must match vector_store.faiss -- after changing the model or
# the endpoint, rebuild it with `python -m oekg.build_index`.
# OEKG_EMBEDDING_BASE_URL=https://litellm.uni-osnabrueck.de/v1
# OEKG_EMBEDDING_MODEL=bge-m3

# Retrieval / pipeline limits
# OEKG_RETRIEVAL_TOP_K=10
# OEKG_MAX_USER_HISTORY=5
# OEKG_MAX_SUMMARY_CHARS=10000
# OEKG_MAX_INPUT_CHARS=2000

# SPARQL generation guards
# OEKG_URI_VALIDATION=1
# OEKG_NORMALISE_OUTPUT=1
# OEKG_SYNTAX_VALIDATION=1
# OEKG_SCHEMA_VALIDATION=1
# OEKG_ENTITY_GROUNDING=1
# OEKG_GROUNDING_MAX_MENTIONS=6
# OEKG_GROUNDING_MIN_LEN=3
# OEKG_GROUNDING_RESULTS_PER_MENTION=5
# OEKG_NEAR_MISS=1
# OEKG_NEAR_MISS_LIMIT=8
# OEKG_NEAR_MISS_MIN_TOKEN=4

# Prompt caching (optional routing key; caching itself is automatic)
# OEKG_PROMPT_CACHE_KEY=

# OEP SPARQL endpoint
# OEKG_SPARQL_ENDPOINT=https://openenergyplatform.org/api/v0/oekg/sparql/
# OEKG_SPARQL_RETRIES=3
# OEKG_SPARQL_RETRY_DELAY=2
# OEKG_SPARQL_TIMEOUT=30
# OEKG_SPARQL_REPAIR_ROUNDS=2

# OEP data REST API (dataset preview + metadata)
# OEKG_OEP_API_BASE=https://openenergyplatform.org/api/v0
# OEKG_DATASET_PREVIEW_ROWS=50

# Caching
# OEKG_CACHE_ENABLED=1
# OEKG_CACHE_PATH=query_cache.json
# OEKG_SEMANTIC_CACHE=1
# OEKG_SEMANTIC_CACHE_THRESHOLD=0.92

# Privacy / consent gate
# Point this at your own document if you operate a modified deployment.
# OEKG_PRIVACY_POLICY_PATH=PRIVACY.md
# Only set this to 0 where consent is already obtained elsewhere.
# OEKG_REQUIRE_CONSENT=1

# Logging
# NOTE: logs/requests.log records the text of every question asked. Keep the
# log directory access-restricted and covered by your retention policy.
# OEKG_LOG_DIR=logs
# OEKG_LOG_LEVEL=INFO
